<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifiesto MSIX de win11-triage (Microsoft Store / instalación local).
  scripts/build_msix.ps1 sustituye los marcadores {{...}}:
    IDENTITY_NAME / PUBLISHER / PUBLISHER_DISPLAY: los da Partner Center (Producto > Identidad del producto).
    VERSION: versión de la app con revisión 0 (requisito de la Store), p. ej. 3.0.0.0
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="{{IDENTITY_NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>win11-triage</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Triaje defensivo para Windows 11: persistencia, procesos, eventos, extensiones y reputación, con puntuación explicable y MITRE ATT&amp;CK.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="es-ES" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="win11triage" Executable="win11-triage-gui.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="win11-triage"
        Description="Triaje defensivo para Windows 11"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- «win11-triage» en cualquier consola abre la CLI incluida en el paquete -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="win11-triage.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="win11-triage.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- Aplicación de escritorio Win32: necesaria para leer procesos, eventos y el registro -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
