# Copia este archivo como .env y rellena tu clave.
# Obtén la API key gratuita en https://www.virustotal.com/gui/my-apikey
VT_API_KEY=pon_aqui_tu_api_key

# (Opcional) Carpeta donde tienes las herramientas de Sysinternals.
# Si no se define, se busca en el PATH y en %LOCALAPPDATA%\Microsoft\WinGet.
# SYSINTERNALS_DIR=C:\Tools\SysinternalsSuite
