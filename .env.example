# Copia este archivo como .env (en la carpeta de configuración) y rellena tu clave.
# API key gratuita: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=pon_aqui_tu_api_key

# (Opcional) Reputación con --intel. Claves gratuitas:
#   AbuseIPDB:     https://www.abuseipdb.com/account/api
#   MalwareBazaar: https://auth.abuse.ch/
# ABUSEIPDB_API_KEY=
# MALWAREBAZAAR_API_KEY=

# (Opcional) Asistente de IA. Clave gratuita de Groq: https://console.groq.com/keys
# GROQ_API_KEY=
# Alternativa local y sin Internet: instala Ollama (https://ollama.com) y usa
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1

# (Opcional) Carpeta con las herramientas de Sysinternals.
# Si no se define, se busca en el PATH y en %LOCALAPPDATA%\Microsoft\WinGet.
# SYSINTERNALS_DIR=C:\Tools\SysinternalsSuite
